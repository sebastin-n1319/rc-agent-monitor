{
  "manifest_version": 3,
  "name": "Adit Expert for Zoho Desk",
  "version": "1.0.0",
  "description": "Adit Expert's review of the Zoho Desk ticket you have open, in a side panel: verdict, findings, other practices with the same problem, the reply and the private note.",
  "key": "",
  "permissions": ["sidePanel", "tabs"],
  "host_permissions": ["https://desk.zoho.com/*", "https://help.adit.com/*", "https://rc-t1cs-monitor.up.railway.app/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Adit Expert" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
